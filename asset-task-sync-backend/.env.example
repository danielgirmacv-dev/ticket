APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=https://it-support.eecproducts.com

# Self-registration: auto-activate after N minutes if still pending (0 = manual only)
REGISTRATION_AUTO_APPROVE_AFTER_MINUTES=2
REGISTRATION_SUPPORT_EMAIL=itsupport@eecproducts.com

# ---------------------------------------------------------------------------
# SMS notifications (Ethio Telecom gateway / aggregator) — see SMS_SETUP.md
# ---------------------------------------------------------------------------
# SMS_DRIVER=log  -> messages are only written to the log (safe default)
# SMS_DRIVER=api  -> real sending via SMS_API_URL
SMS_DRIVER=log
SMS_API_URL=
# Auth: bearer | basic | header | none
SMS_AUTH_MODE=bearer
SMS_API_KEY=
SMS_USERNAME=
SMS_PASSWORD=
SMS_AUTH_HEADER=KEY
SMS_SENDER_ID=
# JSON body field names — must match your provider's API docs
SMS_TO_FIELD=to
SMS_MESSAGE_FIELD=message
SMS_SENDER_FIELD=sender_id

# ---------------------------------------------------------------------------
# Telegram Bot notifications
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
