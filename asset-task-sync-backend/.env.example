APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=https://it-support.eecproducts.com

# Self-registration: auto-activate after N minutes if still pending (0 = manual only)
REGISTRATION_AUTO_APPROVE_AFTER_MINUTES=2
REGISTRATION_SUPPORT_EMAIL=itsupport@eecproducts.com
FRONTEND_URL=https://it-support.eecproducts.com

# ---------------------------------------------------------------------------
# SMS notifications — see SMS_SETUP.md
# ---------------------------------------------------------------------------
# SMS_DRIVER=log  -> messages are only written to the log (safe for development)
# SMS_DRIVER=api  -> real sending via SMS_API_URL
SMS_DRIVER=log
SMS_API_URL=http://msgg.milkotech.et/api/send/sms
# Auth mode: body | bearer | header | basic | none
SMS_AUTH_MODE=body
SMS_API_KEY=d0e22120ab8858fbea33550270987c495a1c60d2
SMS_DEVICE_ID=f0388479aa0563f6
SMS_MODE=devices
SMS_SIM=1
SMS_CONTENT_TYPE=form
SMS_TO_FIELD=phone
SMS_MESSAGE_FIELD=message

# ---------------------------------------------------------------------------
# Telegram Bot notifications
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
